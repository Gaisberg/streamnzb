# All the rest are configurable via the UI
INDEXER_QUERY_HEADER=MAKE
INDEXER_GRAB_HEADER=ME

# Persistence. Defaults to SQLite at <data dir>/streamnzb.db; no setup needed.
# Set both of these to run against an existing Postgres server instead. An
# existing streamnzb.db is imported once on the first Postgres start.
#DATABASE_DRIVER=postgres
#DATABASE_URL=postgres://user:password@db-host:5432/streamnzb?sslmode=disable
