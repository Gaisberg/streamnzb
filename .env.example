# ──────────────────────────────────────────────────────────────
# StreamNZB — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All settings are read once at startup; changes require a restart.

# ── General ──────────────────────────────────────────────────
# ADDON_PORT=7000
# ADDON_BASE_URL=https://streamnzb.example.com
# LOG_LEVEL=INFO
# KEEP_LOG_FILES=9
# MEMORY_LIMIT_MB=512
# TZ=UTC

# ── Usenet Providers (up to 10: PROVIDER_1_ … PROVIDER_10_) ─
# Only HOST is required; the rest have sensible defaults.

PROVIDER_1_NAME=My Primary Provider
PROVIDER_1_HOST=news.example.com
PROVIDER_1_PORT=563
PROVIDER_1_USERNAME=myuser
PROVIDER_1_PASSWORD=mypassword
PROVIDER_1_CONNECTIONS=10
PROVIDER_1_SSL=true
PROVIDER_1_PRIORITY=1
PROVIDER_1_ENABLED=true

# PROVIDER_2_NAME=Backup Provider
# PROVIDER_2_HOST=news.backup.com
# PROVIDER_2_PORT=563
# PROVIDER_2_USERNAME=backupuser
# PROVIDER_2_PASSWORD=backuppass
# PROVIDER_2_CONNECTIONS=5
# PROVIDER_2_SSL=true
# PROVIDER_2_PRIORITY=2
# PROVIDER_2_ENABLED=true

# ── Indexers (up to 10: INDEXER_1_ … INDEXER_10_) ────────────
# Only URL is required per indexer.

INDEXER_1_NAME=My NZB Indexer
INDEXER_1_URL=https://api.nzbindexer.com
INDEXER_1_API_KEY=your-indexer-api-key
INDEXER_1_API_PATH=/api
INDEXER_1_TYPE=newznab
INDEXER_1_ENABLED=true

# INDEXER_2_NAME=Second Indexer
# INDEXER_2_URL=https://api.anotherindexer.com
# INDEXER_2_API_KEY=another-api-key
# INDEXER_2_API_PATH=/api
# INDEXER_2_TYPE=newznab
# INDEXER_2_ENABLED=true

# ── Indexer HTTP Headers ─────────────────────────────────────
# Custom User-Agent sent with indexer search/grab requests.
# Defaults to "StreamNZB/<version>" if not set.
# INDEXER_QUERY_HEADER=StreamNZB
# INDEXER_GRAB_HEADER=StreamNZB

# ── NNTP Proxy ───────────────────────────────────────────────
# Exposes your usenet pool as a local NNTP server.
# Set NNTP_PROXY_PORT=0 to disable.
# NNTP_PROXY_PORT=119
# NNTP_PROXY_HOST=0.0.0.0
# NNTP_PROXY_AUTH_USER=streamnzb
# NNTP_PROXY_AUTH_PASS=streamnzb

# ── AvailNZB ─────────────────────────────────────────────────
# AVAILNZB_MODE=full
#   Possible values:
#     full        – fetch availability status AND report playback results (default)
#     status_only – fetch availability status but never report back
#     disabled    – disable AvailNZB entirely