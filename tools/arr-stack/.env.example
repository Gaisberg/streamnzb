# The address of the machine running Docker, as the Docker host's kernel can
# reach it — a LAN IP, not localhost and not a service name. StreamNZB's 2049
# is published there, and the *arrs' NFS volume is mounted from it.
NFS_HOST=192.168.1.225

# A stream's token from StreamNZB → Settings → Streams. It is the exported
# path on the NFS mount and the API key the *arrs use for the download client.
STREAM_TOKEN=

# Host ports. Chosen beside the defaults so a StreamNZB already running on
# this machine (7000, 2049) does not collide.
WEB_PORT=7001
NFS_PORT=2050

# Optional.
STREAMNZB_IMAGE=streamnzb:arr-test
LOG_LEVEL=debug
TZ=Europe/Helsinki
# Silo media server (omnibus image: bundled PostgreSQL and Redis).
SILO_SECRET_KEY=
SILO_PORT=8090
SILO_JF_PORT=8096
